{
  "api_base": "https://api.github.com",
  "repository_name": "acmm-mcp-arena-experiment-2",
  "repository_full_name": "Dufferin125/acmm-mcp-arena-experiment-2",
  "repository_id": 1447536932,
  "require_private": true,
  "fixture_branch_prefix": "acmm/",
  "fixture_marker": "acmm-fixture",
  "expected_default_branch": "main",
  "fixture_base": {
    "version": "0.1",
    "files": [
      {
        "path": "README.md",
        "resource": "assets/fixture_base/README.md"
      },
      {
        "path": ".acmm/fixture-base.json",
        "resource": "assets/fixture_base/fixture-base.json"
      }
    ]
  },
  "disposable_repositories": {
    "probe_name_prefix": "acmm-e2-lifecycle-probe",
    "run_name_prefix": "acmm-e2-run"
  },
  "api_policy": {
    "mutation_interval_seconds": 2.0,
    "content_requests_per_minute": 60,
    "content_requests_per_hour": 360,
    "max_secondary_retries": 5,
    "secondary_backoff_seconds": [
      60.0,
      120.0,
      240.0,
      480.0,
      960.0
    ],
    "primary_remaining_floor": 1000,
    "primary_reset_grace_seconds": 3.0,
    "provider_authoritative_rate_limits": true,
    "retry_after_grace_seconds": 3.0,
    "request_interval_seconds": 1.0
  },
  "github_app": {
    "app_id": 5713970,
    "installation_id": 180917216,
    "slug": "acmm-github-app"
  },
  "git_policy": {
    "push_interval_seconds": 12.0,
    "remote_read_interval_seconds": 0.1
  }
}
